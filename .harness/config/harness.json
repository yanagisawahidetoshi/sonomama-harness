{
  "version": 1,
  "provider": "fake",
  "sbi": ".harness/state/sample-sbi.json",
  "maxConsecutiveFailures": 3,
  "maxIterations": 5,
  "timeoutMs": 120000,
  "github": {
    "remote": "origin",
    "base": "main",
    "requiredChecks": [
      "harness"
    ]
  },
  "verifiers": [
    {
      "id": "rails",
      "directory": "apps/api",
      "marker": "Gemfile",
      "planned": [
        "RSpec",
        "RuboCop",
        "Brakeman",
        "OpenAPI"
      ],
      "commands": [],
      "appliesTo": [
        "^apps/api/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "expo",
      "directory": "apps/mobile",
      "marker": "package.json",
      "planned": [
        "TypeScript",
        "Biome",
        "Jest",
        "RNTL",
        "Expo Doctor"
      ],
      "commands": [
        [
          "pnpm",
          "install",
          "--frozen-lockfile",
          "--prefer-offline",
          "--filter",
          "mobile"
        ],
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "run",
          "check"
        ],
        [
          "pnpm",
          "run",
          "test"
        ],
        [
          "pnpm",
          "run",
          "doctor"
        ]
      ],
      "appliesTo": [
        "^apps/mobile/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "mobile-acceptance",
      "directory": "apps/mobile",
      "marker": "package.json",
      "planned": [
        "Trusted Acceptance"
      ],
      "commands": [],
      "acceptanceIds": [
        "MOBILE-AC-1",
        "MOBILE-AC-2",
        "MOBILE-AC-3",
        "MOBILE-AC-4",
        "MOBILE-AC-5",
        "MOBILE-AC-6",
        "MOBILE-AC-7",
        "MOBILE-AC-8",
        "MOBILE-AC-9",
        "MOBILE-AC-10",
        "MOBILE-AC-11",
        "MOBILE-AC-12",
        "MOBILE-AC-13",
        "MOBILE-AC-14",
        "MOBILE-AC-15",
        "MOBILE-AC-16",
        "MOBILE-AC-17",
        "MOBILE-AC-18",
        "MOBILE-AC-19",
        "MOBILE-AC-20"
      ],
      "appliesTo": [],
      "lanes": [
        "production"
      ],
      "trust": "acceptance",
      "trustedScript": ".harness/verification/mobile-env.mjs"
    },
    {
      "id": "admin",
      "directory": "apps/admin",
      "marker": "package.json",
      "planned": [
        "TypeScript",
        "Biome",
        "Vitest",
        "RTL",
        "build"
      ],
      "commands": [
        [
          "pnpm",
          "install",
          "--frozen-lockfile",
          "--prefer-offline",
          "--filter",
          "admin"
        ],
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "run",
          "check"
        ],
        [
          "pnpm",
          "run",
          "test"
        ],
        [
          "pnpm",
          "run",
          "build",
          "--outDir",
          "node_modules/.harness/dist",
          "--emptyOutDir"
        ]
      ],
      "appliesTo": [
        "^apps/admin/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "admin-acceptance",
      "directory": "apps/admin",
      "marker": "package.json",
      "planned": [
        "Trusted Acceptance"
      ],
      "commands": [],
      "acceptanceIds": [
        "ADMIN-AC-1",
        "ADMIN-AC-2",
        "ADMIN-AC-3",
        "ADMIN-AC-4",
        "ADMIN-AC-5",
        "ADMIN-AC-6",
        "ADMIN-AC-7",
