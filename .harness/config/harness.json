{
  "version": 1,
  "provider": "claude",
  "sbi": ".harness/state/sample-sbi.json",
  "maxConsecutiveFailures": 3,
  "maxIterations": 5,
  "timeoutMs": 120000,
  "github": {
    "remote": "origin",
    "base": "main",
    "requiredChecks": [
      "harness"
    ]
  },
  "verifiers": [
    {
      "id": "rails",
      "directory": "apps/api",
      "marker": "Gemfile",
      "planned": [
        "RSpec",
        "RuboCop",
        "Brakeman",
        "Bundler Audit",
        "Zeitwerk"
      ],
      "commands": [
        [
          "node",
          "../../tools/harness/api-contract.mjs",
          "--routes"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "build",
          "api"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bin/rails",
          "db:prepare"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bundle",
          "exec",
          "rspec"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bundle",
          "exec",
          "rubocop"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bundle",
          "exec",
          "brakeman",
          "--no-pager",
          "--quiet"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bundle",
          "exec",
          "bundler-audit",
          "check",
          "--update"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "api",
          "bin/rails",
          "zeitwerk:check"
        ],
        [
          "docker",
          "compose",
          "-f",
          "../../compose.yaml",
          "down"
        ]
      ],
      "appliesTo": [
        "^apps/api/",
        "^packages/",
        "^compose\\.yaml$",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ],
      "areas": [
        "api"
      ],
      "isolation": "compose",
      "network": true
    },
