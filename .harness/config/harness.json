  "securityVerifiers": [
    {
      "id": "migration-safety",
      "directory": ".",
      "commands": [
        [
          "node",
          "tools/harness/migration-safety.mjs"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "build",
          "api"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "-e",
          "DATABASE_URL=postgres://postgres@db:5432/sonomama_migration_safety_test",
          "-e",
          "SCHEMA=/rails/tmp/migration-safety-schema.rb",
          "api",
          "bin/rails",
          "db:drop",
          "db:create",
          "db:migrate"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "-e",
          "DATABASE_URL=postgres://postgres@db:5432/sonomama_migration_safety_test",
          "-e",
          "SCHEMA=/rails/tmp/migration-safety-schema.rb",
          "api",
          "bin/rails",
          "db:migrate",
          "VERSION=0"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "-e",
          "DATABASE_URL=postgres://postgres@db:5432/sonomama_migration_safety_test",
          "-e",
          "SCHEMA=/rails/tmp/migration-safety-schema.rb",
          "api",
          "bin/rails",
          "db:migrate"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "run",
          "--rm",
          "-e",
          "RAILS_ENV=test",
          "-e",
          "DATABASE_URL=postgres://postgres@db:5432/sonomama_migration_safety_test",
          "-e",
          "SCHEMA=/rails/tmp/migration-safety-schema.rb",
          "api",
          "bin/rails",
          "db:drop"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "down"
        ]
      ],
      "isolation": "compose",
      "network": true
    },
    {
      "id": "rails-authz-test",
      "directory": ".",
      "commands": [
        [
          "node",
          "tools/harness/authorization-specs.mjs"
        ],
        [
          "docker",
          "compose",
          "-f",
          "compose.yaml",
          "build",
          "api"
