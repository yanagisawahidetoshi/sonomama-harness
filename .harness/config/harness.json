        "API-AC-20",
        "API-AC-21",
        "API-AC-22"
      ],
      "appliesTo": [],
      "lanes": [
        "production"
      ],
      "trust": "acceptance",
      "trustedScript": ".harness/verification/api-env.mjs"
    },
    {
      "id": "expo",
      "directory": "apps/mobile",
      "marker": "package.json",
      "planned": [
        "TypeScript",
        "Biome",
        "Jest",
        "RNTL",
        "Expo Doctor"
