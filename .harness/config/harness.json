    },
    {
      "id": "prototype-mobile",
      "directory": "prototypes/mobile",
      "marker": "package.json",
      "appliesTo": [
        "^prototypes/mobile/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|tsconfig[^/]*)$"
      ],
      "lanes": [
        "prototype",
        "production"
      ],
      "planned": [
        "TypeScript",
        "ESLint",
        "Prettier",
        "build/export"
      ],
      "commands": [
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "run",
          "lint"
        ],
        [
          "pnpm",
          "run",
          "format:check"
        ],
        [
