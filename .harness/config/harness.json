{
  "version": 1,
  "provider": "fake",
  "sbi": ".harness/state/sample-sbi.json",
  "maxConsecutiveFailures": 3,
  "maxIterations": 5,
  "timeoutMs": 120000,
  "github": {
    "remote": "origin",
    "base": "main",
    "requiredChecks": [
      "harness"
    ]
  },
  "verifiers": [
    {
      "id": "rails",
      "directory": "apps/api",
      "marker": "Gemfile",
      "planned": [
        "RSpec",
        "RuboCop",
        "Brakeman",
        "OpenAPI"
      ],
      "commands": [],
      "appliesTo": [
        "^apps/api/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "expo",
      "directory": "apps/mobile",
      "marker": "package.json",
      "planned": [
        "TypeScript",
        "ESLint",
        "RNTL",
        "Storybook",
        "Maestro"
      ],
      "commands": [],
      "appliesTo": [
        "^apps/mobile/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "admin",
      "directory": "apps/admin",
      "marker": "package.json",
      "planned": [
        "TypeScript",
        "ESLint",
        "Vitest",
        "RTL",
        "Storybook",
        "Playwright",
        "VRT"
      ],
      "commands": [],
      "appliesTo": [
        "^apps/admin/",
        "^packages/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|\\.ruby-version|\\.tool-versions|tsconfig[^/]*)$"
      ],
      "lanes": [
        "production"
      ]
    },
    {
      "id": "prototype-web",
      "directory": "prototypes/web",
      "marker": "package.json",
      "appliesTo": [
        "^prototypes/web/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|tsconfig[^/]*)$"
      ],
      "lanes": [
        "prototype",
        "production"
      ],
      "planned": [
        "TypeScript",
        "ESLint",
        "Prettier",
        "build/export"
      ],
      "commands": [
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "run",
          "lint"
        ],
        [
          "pnpm",
          "run",
          "format:check"
        ],
        [
          "pnpm",
          "run",
          "build"
        ]
      ]
    },
    {
      "id": "prototype-mobile",
      "directory": "prototypes/mobile",
      "marker": "package.json",
      "appliesTo": [
        "^prototypes/mobile/",
        "^(package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|\\.npmrc|tsconfig[^/]*)$"
      ],
      "lanes": [
        "prototype",
        "production"
      ],
      "planned": [
        "TypeScript",
        "ESLint",
        "Prettier",
        "build/export"
      ],
      "commands": [
        [
          "pnpm",
          "run",
          "typecheck"
        ],
        [
          "pnpm",
          "run",
          "lint"
        ],
        [
          "pnpm",
          "run",
          "format:check"
        ],
        [
          "pnpm",
          "run",
          "build"
        ]
      ]
    }
  ],
  "semanticReview": {
    "enabled": false
  }
}
