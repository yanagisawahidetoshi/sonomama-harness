{
  "version": 1,
  "defaultLevel": 2,
  "levels": {
    "1": {
      "requiredHumanApprovals": 0,
      "autoMerge": true
    },
    "2": {
      "requiredHumanApprovals": 1,
      "autoMerge": false
    },
    "3": {
      "requiredHumanApprovals": 2,
      "autoMerge": false
    }
  },
  "pathRules": [
    {
      "id": "auth",
      "pattern": "(^|/)(auth|authn|authz|authentication|authorization)(/|\\.|$)",
      "minimumLevel": 3
    },
    {
      "id": "security",
      "pattern": "(^|/)(security|rls|policies|permissions|roles)(/|\\.|$)",
      "minimumLevel": 3
    },
    {
      "id": "migration",
      "pattern": "(^|/)(migrate|migrations)(/|$)",
      "minimumLevel": 3
    },
    {
      "id": "schema",
      "pattern": "(^|/)(schema\\.(rb|sql|prisma)|structure\\.sql)$",
      "minimumLevel": 3
    },
    {
      "id": "adr",
      "pattern": "(^|/)docs/adr(/|$)",
      "minimumLevel": 3
    },
    {
      "id": "cicd",
      "pattern": "(^|/)(\\.github|\\.gitlab|\\.circleci)(/|$)|(^|/)(Jenkinsfile|Dockerfile|docker-compose[^/]*|.*\\.tf)$",
      "minimumLevel": 3
    },
    {
      "id": "infrastructure",
      "pattern": "(^|/)(infra|infrastructure|terraform|deploy|deployment|release|k8s|helm)(/|\\.|$)",
      "minimumLevel": 3
    },
    {
      "id": "secret",
      "pattern": "(^|/)(\\.env[^/]*|secrets?|credentials?)(/|\\.|$)|\\.(pem|key|p12)$",
      "minimumLevel": 3
    },
    {
      "id": "harness_policy",
      "pattern": "(^|/)(\\.harness|tools/harness)(/|$)|(^|/)AGENTS\\.md$",
      "minimumLevel": 3
    },
    {
      "id": "api_contract",
      "pattern": "(^|/)packages/api-schema(/|$)",
      "minimumLevel": 3
    },
    {
      "id": "session_authentication",
      "pattern": "(^|/)(sessions?|login|passwords?|tokens?)([_./-]|$)",
      "minimumLevel": 3
    },
    {
      "id": "security_policy",
      "pattern": "(^|/)docs/security(/|$)",
      "minimumLevel": 3
    }
  ],
  "metadataRules": [
    {
      "id": "authn_changed",
      "pattern": "\\bauthn\\b|\\bauthentication\\b|認証",
      "minimumLevel": 3
    },
    {
      "id": "authz_changed",
      "pattern": "\\bauthz\\b|\\bauthorization\\b|権限",
      "minimumLevel": 3
    },
    {
      "id": "rls_changed",
      "pattern": "\\brls\\b|row.level.security",
      "minimumLevel": 3
    },
    {
      "id": "pii_access_changed",
      "pattern": "\\bpii\\b|個人情報",
      "minimumLevel": 3
    },
    {
      "id": "db_migration",
      "pattern": "\\bmigration\\b|\\bmigrations\\b|DB移行",
      "minimumLevel": 3
    },
    {
      "id": "db_schema_changed",
      "pattern": "\\bdb.schema\\b|\\bdatabase.schema\\b|\\bschema.change\\b|スキーマ変更",
      "minimumLevel": 3
    },
    {
      "id": "permission_model",
      "pattern": "permission.model|role.model|アクセス範囲",
      "minimumLevel": 3
    },
    {
      "id": "production_data",
      "pattern": "production.data|本番データ",
      "minimumLevel": 3
    },
    {
      "id": "secret_changed",
      "pattern": "\\bsecrets?\\b|\\bcredentials?\\b|秘密鍵",
      "minimumLevel": 3
    },
    {
      "id": "security_rule",
      "pattern": "security.rule|セキュリティルール",
      "minimumLevel": 3
    },
    {
      "id": "cicd_changed",
      "pattern": "ci/cd|\\bcicd\\b|deploy.workflow|release.workflow",
      "minimumLevel": 3
    },
    {
      "id": "infra_changed",
      "pattern": "\\binfrastructure\\b|インフラ",
      "minimumLevel": 3
    },
    {
      "id": "destructive_operation",
      "pattern": "destructive.operation|破壊的操作",
      "minimumLevel": 3
    },
    {
      "id": "architecture_decision",
      "pattern": "\\badr\\b|重要設計",
      "minimumLevel": 3
    },
    {
      "id": "breaking_api",
      "pattern": "breaking.api|API互換性",
      "minimumLevel": 3
    },
    {
      "id": "data_retention",
      "pattern": "\\bretention\\b|\\banonymization\\b|data.deletion|データ削除|匿名化",
      "minimumLevel": 3
    },
    {
      "id": "sql_schema_operation",
      "pattern": "\\b(ALTER|CREATE|DROP)\\s+(TABLE|POLICY|ROLE|SCHEMA)\\b",
      "minimumLevel": 3
    },
    {
      "id": "destructive_data_operation",
      "pattern": "\\b(delete_all|destroy_all|TRUNCATE)\\b|\\bDROP\\s+TABLE\\b",
      "minimumLevel": 3
    }
  ],
  "safeRules": [
    {
      "id": "explicit_safe_docs_only",
      "pattern": "^docs/(?!adr/).+\\.(md|txt|rst)$",
      "candidateLevel": 1,
      "allowedStatuses": [
        "A",
        "M"
      ],
      "maxChangedBytes": 32768
    },
    {
      "id": "explicit_safe_prototype_only",
      "pattern": "^prototypes/(web|mobile)/.+\\.(tsx?|jsx?|mjs|json|css|scss|md|txt|html|svg|ya?ml)$",
      "candidateLevel": 1,
      "requiredLane": "prototype",
      "allowedStatuses": [
        "A",
        "M"
      ],
      "maxChangedBytes": 32768
    }
  ]
}
