{
  "version": 1,
  "defaultLevel": 1,
  "levels": {
    "1": {
      "requiredHumanApprovals": 0,
      "autoMerge": true
    },
    "2": {
      "requiredHumanApprovals": 1,
      "autoMerge": false
    },
    "3": {
      "requiredHumanApprovals": 2,
      "autoMerge": false
    }
  },
  "pathRules": [
    {
      "id": "policy_root",
      "pattern": "^(\\.harness/(rules|state)|\\.github/rulesets|\\.githooks)/",
      "minimumLevel": 3
    },
    {
      "id": "auth",
      "pattern": "(^|/)(auth|authn|authz|authentication|authorization)(/|\\.|$)",
      "minimumLevel": 3
    },
    {
      "id": "session_authentication",
      "pattern": "(^|/)(sessions?|login|passwords?|tokens?)([_./-]|$)",
      "minimumLevel": 3
    },
    {
      "id": "security",
      "pattern": "(^|/)(security|rls|policies|permissions|roles)(/|\\.|$)",
      "minimumLevel": 3
    },
    {
      "id": "security_policy",
      "pattern": "(^|/)docs/security(/|$)",
      "minimumLevel": 3
    },
    {
      "id": "secret",
      "pattern": "(^|/)(\\.env[^/]*|secrets?|credentials?)(/|\\.|$)|\\.(pem|key|p12)$",
      "minimumLevel": 3
    },
    {
      "id": "production_infrastructure",
      "pattern": "^(?=.*?(?:(^|/)(infra|infrastructure|terraform|terragrunt|k8s|kubernetes|helm|charts?|deploy|deployment|live|cdk|pulumi|cloudformation|cfn)(/|$)|(^|/)(?<!(^|/)config/)(environments?|envs)/|\\.(tf|tfvars|hcl)$|\\.tf\\.json$))(?=.*?(^|[/._-])(?<!non[-_])(?<!pre[-_])(prod|prd|production)([/._-]|$))|(^|/)\\.github/workflows/[^/]*(prod|prd|production)[^/]*\\.ya?ml$",
      "minimumLevel": 3
    },
    {
      "id": "infrastructure",
      "pattern": "(^|/)(infra|infrastructure|terraform|terragrunt|k8s|kubernetes|helm|charts?|deploy|deployment|live|cdk|pulumi|cloudformation|cfn)(/|$)|(^|/)(?<!(^|/)config/)(environments?|envs)/|\\.(tf|tfvars|hcl)$|\\.tf\\.json$|(^|/)release(/|\\.|$)",
      "minimumLevel": 2
    },
    {
      "id": "migration",
      "pattern": "(^|/)(migrate|migrations)(/|$)",
      "minimumLevel": 2
    },
    {
      "id": "schema",
      "pattern": "(^|/)(schema\\.(rb|sql|prisma)|structure\\.sql)$",
      "minimumLevel": 2
    },
    {
      "id": "adr",
      "pattern": "(^|/)docs/adr(/|$)",
      "minimumLevel": 2
    },
    {
      "id": "cicd",
      "pattern": "(^|/)(\\.github|\\.gitlab|\\.circleci)(/|$)|(^|/)(Jenkinsfile|Dockerfile|docker-compose[^/]*)$",
      "minimumLevel": 2
    },
    {
      "id": "harness_policy",
      "pattern": "(^|/)(\\.harness|\\.ai|tools/harness)(/|$)|(^|/)AGENTS\\.md$",
      "minimumLevel": 2
    },
    {
      "id": "api_contract",
      "pattern": "(^|/)packages/api-schema(/|$)",
      "minimumLevel": 2
    }
  ],
  "metadataRules": [
    {
      "id": "authn_changed",
      "pattern": "\\bauthn\\b|\\bauthentication\\b|認証",
      "minimumLevel": 3,
      "ignoredPatterns": [
        "認証(は|が)?(不要|なし|無し)(?![^\\n。]*?(ように|可能に|にする|に変更|に変え|化|外す|削除|廃止|やめ|緩和|許可))",
        "認証(ヘッダ|情報|トークン)(や|も)[^\\n。]{0,30}?(付けない|持たない|送らない)(?![^\\n。]*?(ように|可能に|にする|に変更|に変え|化|外す|削除|廃止|やめ|緩和|許可))",
        "未認証(の)?クライアント(でも|が)[^\\n。]{0,20}?(できる|返る|呼べる)(?![^\\n。]*?(ように|可能に|にする|に変更|に変え|化|外す|削除|廃止|やめ|緩和|許可))"
      ]
    },
    {
      "id": "authz_changed",
      "pattern": "\\bauthz\\b|\\bauthorization\\b|権限",
      "minimumLevel": 3
    },
    {
      "id": "rls_changed",
      "pattern": "\\brls\\b|row.level.security",
      "minimumLevel": 3
    },
    {
      "id": "pii_access_changed",
      "pattern": "\\bpii\\b|個人情報",
      "minimumLevel": 3
    },
    {
      "id": "permission_model",
      "pattern": "permission.model|role.model|アクセス範囲",
      "minimumLevel": 3
    },
    {
      "id": "production_data",
      "pattern": "production.data|本番データ",
      "minimumLevel": 3
    },
    {
      "id": "secret_changed",
      "pattern": "\\bsecrets?\\b|\\bcredentials?\\b|秘密鍵",
      "minimumLevel": 3
    },
    {
      "id": "security_rule",
      "pattern": "security.rule|セキュリティルール",
      "minimumLevel": 3
    },
    {
      "id": "destructive_operation",
      "pattern": "destructive.operation|破壊的操作",
      "minimumLevel": 3
    },
    {
      "id": "data_retention",
      "pattern": "\\bretention\\b|\\banonymization\\b|data.deletion|データ削除|匿名化",
      "minimumLevel": 3
    },
    {
      "id": "destructive_data_operation",
      "pattern": "\\b(delete_all|destroy_all|TRUNCATE)\\b",
      "minimumLevel": 3
    },
    {
      "id": "destructive_schema_operation",
      "pattern": "\\bDROP\\s+(TABLE|SCHEMA)\\b",
      "minimumLevel": 3
    },
    {
      "id": "sql_authorization_operation",
      "pattern": "\\b(ALTER|CREATE|DROP)\\s+(POLICY|ROLE)\\b",
      "minimumLevel": 3
    },
    {
      "id": "destructive_migration_operation",
      "pattern": "\\b(drop_table|drop_join_table|remove_column|remove_columns|remove_reference|remove_belongs_to|remove_timestamps)\\b",
      "minimumLevel": 3
    },
    {
      "id": "db_migration",
      "pattern": "\\bmigration\\b|\\bmigrations\\b|DB移行",
      "minimumLevel": 2
    },
    {
      "id": "db_schema_changed",
      "pattern": "\\bdb.schema\\b|\\bdatabase.schema\\b|\\bschema.change\\b|スキーマ変更",
      "minimumLevel": 2
    },
    {
      "id": "sql_schema_operation",
      "pattern": "\\b(ALTER|CREATE)\\s+(TABLE|SCHEMA)\\b",
      "minimumLevel": 2
    },
    {
      "id": "cicd_changed",
      "pattern": "ci/cd|\\bcicd\\b|deploy.workflow|release.workflow",
      "minimumLevel": 2
    },
    {
      "id": "infra_changed",
      "pattern": "\\binfrastructure\\b|インフラ",
      "minimumLevel": 2
    },
    {
      "id": "architecture_decision",
      "pattern": "\\badr\\b|重要設計",
      "minimumLevel": 2
    },
    {
      "id": "breaking_api",
      "pattern": "breaking.api|API互換性",
      "minimumLevel": 2
    }
  ],
  "testProtection": {
    "pathPattern": "(^|/)(spec|specs|test|tests|__tests__|e2e|\\.maestro)/|\\.(test|spec)\\.[cm]?[jt]sx?$|_(spec|test)\\.rb$",
    "weakeningPattern": "\\.(only|skip)\\s*\\(|\\b(xit|xdescribe|xcontext|xtest|fit|fdescribe|fcontext)\\s*\\(|\\b(it|test|describe)\\.todo\\b|:focus\\b|\\bfocus:\\s*true\\b|^\\s*(skip|pending)\\b",
    "assertionPattern": "\\bexpect\\s*[({]|\\bassert(\\.\\w+)?\\s*\\(|\\bassert_\\w+|\\.should\\b|\\bis_expected\\b|\\bt\\.(is|deepEqual|true|false)\\s*\\(",
    "minimumLevel": 2
  }
}
