{
  "name": "prototype-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "EXPO_USE_PRECOMPILED_MODULES=0 expo run:ios",
    "android": "expo run:android",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook-generate": "sb-rn-get-stories --config-path .rnstorybook",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@storybook/react-native": "10.7.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.21.5",
    "typescript": "~6.0.3"
  }
}
