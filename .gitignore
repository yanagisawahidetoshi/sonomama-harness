node_modules/
.harness/runs/*
!.harness/runs/.gitkeep
.harness/state/runs/*
!.harness/state/runs/.gitkeep

# Local human approval signing material; never commit or copy to the agent workspace.
.harness/state/human/
# Signed record of what the API Schema Planner generated; local trust state like the approval ledger.
.harness/state/api-schema/

# Sensitive source files are never review/export artifacts.
**/.env
**/.env.*
# Placeholder-only templates are tracked; Harness still inspects their content (isSafeEnvTemplate).
!**/.env.example
!**/.env.*.example
!**/.env.sample
!**/.env.*.sample
!**/.env.template
!**/.env.*.template
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*
**/secrets*
**/.upload-access-key
!docs/security/secrets.md
.harness/exports/
