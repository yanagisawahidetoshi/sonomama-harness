{
  "name": "sonomama",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=8.15.2 <9"
  },
  "scripts": {
    "harness:check": "node tools/harness/cli.mjs check",
    "harness:demo": "node tools/harness/cli.mjs demo",
    "harness:run": "node tools/harness/cli.mjs run",
    "planner:sbi": "node tools/harness/cli.mjs plan",
    "planner:api-schema": "node tools/harness/cli.mjs api-schema",
    "planner:api-schema-approve": "node tools/harness/cli.mjs api-schema-approve",
    "planner:api-schema-status": "node tools/harness/cli.mjs api-schema-status",
    "harness:test": "node --test tools/harness/*.test.mjs tools/harness/agents/*.test.mjs",
    "harness:approve": "node tools/harness/cli.mjs approve",
    "harness:resume": "node tools/harness/cli.mjs resume",
    "harness:export": "node tools/harness/cli.mjs export",
    "hooks:install": "node tools/harness/install-hooks.mjs",
    "prepare": "node tools/harness/install-hooks.mjs",
    "harness:cleanup": "node tools/harness/cli.mjs cleanup"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.14.2"
  },
  "pnpm": {
    "overrides": {
      "@stoplight/prism-core": "5.8.0",
      "@stoplight/prism-http": "5.12.0",
      "@stoplight/prism-http-server": "5.12.2"
    },
    "neverBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
